# Copy to `.env` and fill in. Everything has a sensible default except the
# Groq key, so the only required step is choosing an LLM provider below.

# ── LLM provider ────────────────────────────────────────────────────────
# "groq"  -> free, fast, hosted. Get a key at https://console.groq.com/keys
# "ollama"-> fully local / offline. Requires Ollama + a pulled model.
LLM_PROVIDER=groq

# Needed only when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Groq rotates models every few months. If you get a model_not_found
# error, pick a current one from https://console.groq.com/docs/models

# Needed only when LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# ── Retrieval (safe defaults; tune and let the eval gate catch regressions) ─
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# FINAL_TOP_K=4
# MIN_RERANK_SCORE=-6.0

# ── Server ──────────────────────────────────────────────────────────────
# PORT=8000
